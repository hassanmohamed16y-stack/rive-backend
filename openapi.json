    "/api/v1/admin/orders": {
      "get": {
        "operationId": "AdminOrdersController_findAll",
        "parameters": [
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "PENDING",
                "PAID",
                "SHIPPED",
                "DELIVERED",
                "CANCELLED",
                "EXPIRED"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated orders returned.",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List all orders with status filtering and pagination (Admin)",
        "tags": [
          "admin orders"
        ]
      }
    },
    "/api/v1/admin/orders/{id}": {
      "get": {
        "operationId": "AdminOrdersController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order returned successfully."
          },
          "404": {
            "description": "Order not found."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get an order by id with full detail (Admin)",
        "tags": [
          "admin orders"
        ]
      }
    },
    "/api/v1/admin/orders/{id}/status": {
      "patch": {
        "operationId": "AdminOrdersController_updateStatus",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateOrderStatusDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order status updated."
          },
          "409": {
            "description": "Invalid order status transition."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Transition an order to a valid status (Admin)",
        "tags": [
          "admin orders"
        ]
      }
    },
    "/api/v1/internal/expire-reservations": {
      "post": {
        "operationId": "InternalOrdersController_expireReservations",
        "parameters": [
          {
            "name": "x-internal-cron-secret",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Number of reservations expired."
          },
          "401": {
            "description": "Missing or invalid internal cron secret."
          },
          "403": {
            "description": "INTERNAL_CRON_SECRET is not configured on this server."
          }
        },
        "summary": "Expire lapsed PENDING order reservations (internal cron only)",
        "tags": [
          "internal"
        ]
      }
    },
    "/api/v1/upload/image": {
      "post": {
        "operationId": "UploadController_uploadImage",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Image uploaded successfully."
          },
          "400": {
            "description": "Invalid file type or file too large."
          },
          "401": {
            "description": "Unauthorized."
          },
          "403": {
            "description": "Forbidden. ADMIN role required."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Upload an image to Cloudinary (ADMIN only)",
        "tags": [
          "upload"
        ]
      }
    },
    "/api/v1/payments/create-checkout-session": {
      "post": {
        "operationId": "PaymentController_createCheckoutSession",
        "parameters": [
          {
            "name": "X-Order-Access-Token",
            "in": "header",
            "description": "Required for guest order checkout.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "orderId": {
                    "type": "string",
                    "example": "cm123abc456def"
                  }
                },
                "required": [
                  "orderId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Checkout session created successfully."
          },
          "400": {
            "description": "Order was already processed."
          },
          "403": {
            "description": "Unauthorized order access."
          },
          "404": {
            "description": "Order not found."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Create or reuse Checkout for an authenticated order owner, admin, or guest access-token holder",
        "tags": [
          "payments"
        ]
      }
    },
    "/api/v1/payments/webhook": {
      "post": {
        "operationId": "PaymentController_handleWebhook",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Webhook received and processed."
          },
          "400": {
            "description": "Invalid webhook payload."
          }
        },
        "summary": "Handle raw payment provider webhook events",
        "tags": [
          "payments"
        ]
      }
    }
  },
  "info": {
    "title": "RIVE Luxury Store API",
    "description": "Luxury e-commerce backend for the RIVE storefront",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "products",
      "description": ""
    },
    {
      "name": "categories",
      "description": ""
    },
    {
      "name": "orders",
      "description": ""
    },
    {
      "name": "auth",
      "description": ""
    },
    {
      "name": "internal",
      "description": ""
    },
    {
      "name": "health",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "example": "Aisha Rahman",
            "minLength": 2,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "example": "aisha@example.com",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "example": "StrongPass123!",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "fullName",
          "email",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "aisha@example.com"
          },
          "password": {
            "type": "string",
            "example": "StrongPass123!"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "ConfirmEmailVerificationDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "example": "CurrentPass123!",
            "maxLength": 128
          },
          "newPassword": {
            "type": "string",
            "example": "NewStrongPass123!",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "aisha@example.com",
            "maxLength": 254
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "a1b2c3...",
            "maxLength": 512
          },
          "newPassword": {
            "type": "string",
            "example": "NewStrongPass123!",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "token",
          "newPassword"
        ]
      },
      "CreateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Lingerie",
            "maxLength": 256
          },
          "slug": {
            "type": "string",
            "example": "lingerie",
            "maxLength": 256
          },
          "description": {
            "type": "string",
            "example": "Luxury essentials designed for slow rituals.",
            "maxLength": 1000
          },
          "isFeatured": {
            "type": "boolean",
            "example": false,
            "default": false
          }
        },
        "required": [
          "name",
          "slug"
        ]
      },
      "UpdateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "slug": {
            "type": "string",
            "maxLength": 256
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "isFeatured": {
            "type": "boolean"
          }
        }
      },
      "ProductImageDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "example": "https://images.example.com/product-1.png",
            "maxLength": 2048
          },
          "altText": {
            "type": "string",
            "example": "Luna silk set front view",
            "maxLength": 500
          },
          "isPrimary": {
            "type": "boolean",
            "example": true,
            "default": false
          }
        },
        "required": [
          "url"
        ]
      },
      "ProductVariantDto": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "example": "LUNA-SET-S-BEIGE",
            "maxLength": 128
          },
          "colorHex": {
            "type": "string",
            "example": "#945958",
            "default": "#945958"
          },
          "size": {
            "type": "string",
            "enum": [
              "XS",
              "S",
              "M",
              "L",
              "XL"
            ],
            "example": "S"
          },
          "price": {
            "type": "number",
            "example": 280
          },
          "stock": {
            "type": "number",
            "example": 12,
            "default": 0
          },
          "isAvailable": {
            "type": "boolean",
            "example": true,
            "default": true
          }
        },
        "required": [
          "sku",
          "size",
          "price"
        ]
      },
      "CreateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Luna Silk Set",
            "maxLength": 256
          },
          "slug": {
            "type": "string",
            "example": "luna-silk-set",
            "maxLength": 256
          },
          "description": {
            "type": "string",
            "example": "A sculptural layering piece made for evening rituals.",
            "maxLength": 2000
          },
          "shortDescription": {
            "type": "string",
            "example": "Soft-touch, lightweight luxury.",
            "maxLength": 500
          },
          "price": {
            "type": "number",
            "example": 280
          },
          "compareAtPrice": {
            "type": "number",
            "example": 360
          },
          "isFeatured": {
            "type": "boolean",
            "example": false,
            "default": false
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "ACTIVE",
              "ARCHIVED"
            ],
            "example": "ACTIVE"
          },
          "categorySlug": {
            "type": "string",
            "example": "lingerie",
            "maxLength": 256
          },
          "images": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductImageDto"
            }
          },
          "variants": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductVariantDto"
            }
          }
        },
        "required": [
          "name",
          "slug",
          "price",
          "categorySlug",
          "images",
          "variants"
        ]
      },
      "UpdateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "slug": {
            "type": "string",
            "maxLength": 256
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "shortDescription": {
            "type": "string",
            "maxLength": 500
          },
          "price": {
            "type": "number"
          },
          "compareAtPrice": {
            "type": "number"
          },
          "isFeatured": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "ACTIVE",
              "ARCHIVED"
            ]
          }
        }
      },
      "CreateProductVariantDto": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "example": "LUNA-SET-S-BEIGE",
            "maxLength": 128
          },
          "colorHex": {
            "type": "string",
            "example": "#945958",
            "default": "#945958"
          },
          "size": {
            "type": "string",
            "enum": [
              "XS",
              "S",
              "M",
              "L",
              "XL"
            ],
            "example": "S"
          },
          "price": {
            "type": "number",
            "example": 280
          },
          "stock": {
            "type": "number",
            "example": 12,
            "default": 0
          },
          "isAvailable": {
            "type": "boolean",
            "example": true,
            "default": true
          }
        },
        "required": [
          "sku",
          "size",
          "price"
        ]
      },
      "UpdateProductVariantDto": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "example": "LUNA-SET-S-BEIGE",
            "maxLength": 128
          },
          "colorHex": {
            "type": "string",
            "example": "#945958"
          },
          "size": {
            "type": "string",
            "enum": [
              "XS",
              "S",
              "M",
              "L",
              "XL"
            ],
            "example": "S"
          },
          "price": {
            "type": "number",
            "example": 280
          },
          "stock": {
            "type": "number",
            "example": 12,
            "description": "Absolute stock value to set. Not a delta/decrement — actual sale-time decrements happen atomically in orders.service.ts."
          },
          "isAvailable": {
            "type": "boolean",
            "example": true
          },
          "expectedUpdatedAt": {
            "type": "string",
            "example": "2026-09-03T12:00:00.000Z",
            "description": "The variant's current updatedAt, as returned by a prior GET/create/update response. Used for optimistic-locking: the update is rejected with 409 Conflict if the variant was modified by someone else in the meantime."
          }
        },
        "required": [
          "expectedUpdatedAt"
        ]
      },
      "CreateProductImageDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "example": "https://images.example.com/product-1.png",
            "maxLength": 2048
          },
          "altText": {
            "type": "string",
            "example": "Luna silk set front view",
            "maxLength": 500
          },
          "isPrimary": {
            "type": "boolean",
            "example": true,
            "default": false
          }
        },
        "required": [
          "url"
        ]
      },
      "OrderItemDto": {
        "type": "object",
        "properties": {
          "productVariantId": {
            "type": "string",
            "example": "cm3r5xj4g0000s7d7f1q2n9v"
          },
          "quantity": {
            "type": "number",
            "example": 1,
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "productVariantId",
          "quantity"
        ]
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {
          "customerName": {
            "type": "string",
            "example": "Aisha Rahman",
            "minLength": 2,
            "maxLength": 120
          },
          "customerEmail": {
            "type": "string",
            "example": "aisha@example.com",
            "maxLength": 254
          },
          "notes": {
            "type": "string",
            "example": "Gift wrap requested",
            "maxLength": 500
          },
          "items": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItemDto"
            }
          }
        },
        "required": [
          "customerName",
          "customerEmail",
          "items"
        ]
      },
      "UpdateOrderStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "PAID",
              "SHIPPED",
              "DELIVERED",
              "CANCELLED",
              "EXPIRED"
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}
