# ============================================
# RIVÉ Backend Environment Configuration
# ============================================
# SECURITY: Never commit .env to version control
# Never share secrets with anyone
# Use strong, randomly generated values for production

# ============================================
# Core Application
# ============================================

# Node environment: development, staging, production
NODE_ENV=development

# Application port
PORT=3000

# Reverse-proxy hop count for trusted client IP resolution (Nginx/ALB/Cloudflare typically use 1)
TRUST_PROXY_HOPS=1

# ============================================
# JWT Authentication
# ============================================
# REQUIRED in production - use a strong random secret (min 32 chars)
# Generate with: openssl rand -base64 32
# Must be at least 32 characters for production security

JWT_SECRET=change-me-to-a-strong-secret-min-32-characters
JWT_EXPIRATION=1h

# ============================================
# DATABASE (PostgreSQL via Prisma)
# ============================================
# REQUIRED in production

DATABASE_URL=******localhost:5432/rive_backend?schema=public

# Set to true only in an isolated PostgreSQL test database to run concurrency integration tests.
RUN_DATABASE_INTEGRATION_TESTS=false

# Optional production container DB values
POSTGRES_DB=rive_backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ============================================
# Stripe Payment Processing
# ============================================
# REQUIRED in production if payment features are enabled
# Get from: https://dashboard.stripe.com/apikeys

STRIPE_SECRET_KEY=sk_test_change_me_to_actual_key
STRIPE_WEBHOOK_SECRET=whsec_test_change_me_to_actual_key

# ============================================
# File Upload - Cloudinary
# ============================================
# REQUIRED in production if image upload features are enabled
# Get from: https://cloudinary.com/console/settings/api

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Required only when production deployments run the Prisma seed command.
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-admin-password

# ============================================
# Transactional Email (Resend-compatible HTTP API)
# ============================================
# REQUIRED outside local development/test - used to deliver password reset
# and email verification tokens. Never returned in API responses outside
# local development/test.
# Get from: https://resend.com/api-keys

EMAIL_PROVIDER_API_KEY=re_change_me_to_actual_key
EMAIL_FROM_ADDRESS=no-reply@rive.example.com

# ============================================
# Internal Cron Endpoints
# ============================================
# REQUIRED outside local development/test - shared secret used by the external
# scheduler (GitHub Actions / Cloud Scheduler / system cron) to authenticate
# calls to POST /api/v1/internal/expire-reservations.
# Generate with: openssl rand -hex 32

INTERNAL_CRON_SECRET=change-me-to-a-strong-secret-min-32-characters

# ============================================
# CORS Configuration
# ============================================
# Allowed frontend origins (production should use exact URLs)

FRONTEND_URL=http://localhost:3001
ADMIN_FRONTEND_URL=http://localhost:3002

# ============================================
# Logging (optional)
# ============================================

LOG_LEVEL=info
