# ============================================
# RIVÉ Backend Environment Configuration
# ============================================
# SECURITY: Never commit .env to version control
# Never share real secrets or credentials in version control
# Use strong, randomly generated values for production deployments

# ============================================
# Core Application Configuration
# ============================================

# [OPTIONAL] Application environment mode: development, staging, or production
NODE_ENV=development

# [OPTIONAL] Port on which the NestJS backend application runs (default: 3000)
PORT=3000

# [OPTIONAL] Sentry DSN for error logging and APM tracking in production
# Get from: https://sentry.io/
SENTRY_DSN=https://example@o0.ingest.sentry.io/0

# [OPTIONAL] Number of reverse-proxy hops to trust for resolving real client IP (e.g. 1 behind Nginx/ALB/Cloudflare)
TRUST_PROXY_HOPS=1

# ============================================
# Database Configuration (PostgreSQL & Prisma)
# ============================================

# [REQUIRED] Primary PostgreSQL connection string used by Prisma Client (connection pooled URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rive_backend?schema=public

# [OPTIONAL] Direct PostgreSQL connection string for migrations when using poolers like Neon
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rive_backend?schema=public

# [OPTIONAL] Enable database integration test suite on an isolated local database (true/false)
RUN_DATABASE_INTEGRATION_TESTS=false

# [OPTIONAL] Default database credentials for local Docker container setup
POSTGRES_DB=rive_backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ============================================
# Authentication & Security
# ============================================

# [REQUIRED] Strong secret used to sign and verify JWT authentication tokens (min 32 chars)
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-strong-secret-min-32-characters

# [OPTIONAL] JWT token expiration duration (e.g., 1h, 1d, 7d)
JWT_EXPIRATION=1h

# [OPTIONAL] Password assigned to the default admin account created during database seeding (`npm run seed`)
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-admin-password

# ============================================
# Stripe Payment Processing
# ============================================

# [OPTIONAL / REQUIRED FOR PAYMENTS] Stripe API secret key for creating checkout sessions and processing refunds
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_change_me_to_actual_key

# [OPTIONAL / REQUIRED FOR WEBHOOKS] Stripe webhook secret key used to verify incoming webhook signatures
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_test_change_me_to_actual_key

# ============================================
# Cloudinary File Uploads
# ============================================

# [OPTIONAL / REQUIRED FOR UPLOADS] Cloudinary Cloud Name for hosting product variant and category images
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name

# [OPTIONAL / REQUIRED FOR UPLOADS] Cloudinary API Key
CLOUDINARY_API_KEY=your-api-key

# [OPTIONAL / REQUIRED FOR UPLOADS] Cloudinary API Secret
CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# Transactional Email (Resend Provider)
# ============================================

# [OPTIONAL / REQUIRED FOR EMAIL] Resend HTTP API key for password reset and transactional emails
# Get from: https://resend.com/api-keys
EMAIL_PROVIDER_API_KEY=re_change_me_to_actual_key

# [OPTIONAL] Verified sender email address used for outbound emails
EMAIL_FROM_ADDRESS=no-reply@rive.example.com

# ============================================
# Internal Cron & Scheduled Triggers
# ============================================

# [REQUIRED IN PROD] Shared secret used to authenticate calls to POST /api/v1/internal/expire-reservations
# Generate with: openssl rand -hex 32
INTERNAL_CRON_SECRET=change-me-to-a-strong-secret-min-32-characters

# ============================================
# CORS Allowed Origins
# ============================================

# [OPTIONAL] Allowed origin URL for Customer Storefront application
FRONTEND_URL=http://localhost:3001

# [OPTIONAL] Allowed origin URL for Operations / Admin Dashboard application
ADMIN_FRONTEND_URL=http://localhost:3002

# ============================================
# Logging Level
# ============================================

# [OPTIONAL] Application log level output: debug, info, warn, error
LOG_LEVEL=info
