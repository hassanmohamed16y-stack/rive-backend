{
  "name": "rive-backend",
  "version": "1.0.0",
  "description": "RIVÉ luxury e-commerce backend",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "npx prisma migrate deploy && node dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "npx prisma migrate deploy && node dist/src/main.js",
    "prisma:generate": "prisma generate",
    "prisma:seed": "node scripts/seed.js",
    "seed": "prisma db seed",
    "seed:once": "prisma db seed",
    "reset-admin": "node scripts/reset-admin.js",
    "save": "bash scripts/auto-save.sh",
    "export:openapi": "ts-node scripts/export-openapi.ts",
    "lint": "eslint . --ext .ts",
    "test": "node --max-old-space-size=4096 ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "node scripts/seed.js"
  },
  "overrides": {
    "tar": "^7.5.21",
    "multer": "^2.3.0",
    "busboy": "^1.6.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.22.0",
    "@sentry/nestjs": "^10.73.0",
    "@types/bcrypt": "^6.0.0",
    "@types/multer": "^2.2.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cloudinary": "^2.11.0",
    "exceljs": "^4.4.0",
    "file-type": "^22.0.2",
    "googleapis": "^180.0.0",
    "helmet": "^7.0.0",
    "multer": "^2.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0",
    "streamifier": "^0.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@types/exceljs": "^0.5.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^30.0.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
